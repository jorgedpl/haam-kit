#!/usr/bin/env bash
# Git pre-commit hook for humans (agents are covered by the Claude Code hook too).
# Enable once per clone with:  make hooks   (runs: git config core.hooksPath .githooks)
"$(git rev-parse --show-toplevel)/scripts/scan-secrets.sh"
rc=$?
if [ "$rc" = "3" ]; then
  echo "Commit blocked: install gitleaks first (see docs/ONBOARDING.md)." >&2
  exit 1
fi
exit $rc
